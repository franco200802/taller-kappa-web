rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PRODUCTOS — cualquiera lee, solo admin escribe
    match /productos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQs — cualquiera lee, solo admin escribe
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TESTIMONIOS — cualquiera lee, solo admin escribe
    match /testimonios/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CONTACTOS — cualquiera crea (con forma y tamaño validados), solo admin lee.
    // Sin esta validación cualquiera podía escribir documentos arbitrarios
    // (o gigantes) en la colección desde la consola del navegador.
    match /contactos/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'interest', 'zone', 'message', 'leido', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.interest is string && request.resource.data.interest.size() <= 100
        && (!('zone' in request.resource.data) || (request.resource.data.zone is string && request.resource.data.zone.size() <= 100))
        && request.resource.data.leido == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ÓRDENES y USUARIOS — colecciones del sitio viejo (admin.html). El sitio actual no las
    // lee ni las escribe: no hay cuentas de clientes ni pedidos online. Antes cualquier usuario
    // con sesión podía crear documentos sin validar en ambas; ahora solo las ve el admin.
    match /orders/{docId} {
      allow read, write: if isAdmin();
    }
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Helper: es la cuenta administradora Y verificó su email.
    // Sin email_verified, si la cuenta todavía no existe (o el registro con email y
    // contraseña queda abierto), cualquiera podría crear una cuenta con este email
    // desde la API de Firebase y pasar por admin. Además conviene deshabilitar el
    // registro de usuarios nuevos en Authentication (docs/firebase-puesta-en-marcha.md).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ing.franciscomarotta@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
